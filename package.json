{
  "name": "hightouch-schema-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:miro": "npm run build && node scripts/build-miro-export.mjs",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:pages",
    "test:unit": "node --test tests/schema-data.test.mjs tests/schema-layout.test.mjs tests/presentation-fit.test.mjs",
    "test:pages": "npm run build && node --test tests/pages-build.test.mjs",
    "test:miro": "npm run build:miro && node --test tests/miro-export.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "juice": "^11.0.3"
  }
}
